# 服务端口配置
HOST_PORT=8095
PORT=8095

# 认证模式：all（同时支持 OIDC 与快捷演示登录）/ oidc / mock
AUTH_MODE=all

# OIDC 配置（与公司 Authelia 对接）
OIDC_ISSUER=https://auth.chencytech.com
OIDC_CLIENT_ID=red-walk-rally
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://run.chencytech.com/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email groups
OIDC_USERNAME_CLAIM=preferred_username

# 会话密钥与有效期（7天）
SESSION_SECRET=red-walk-rally-super-secret-salt-key-2026
SESSION_TTL_MS=604800000
SECURE_COOKIES=false

# 系统管理员名单（逗号分隔，管理员可重置队伍、导出花名册等）
ADMIN_USERNAMES=hekaixuan,admin
