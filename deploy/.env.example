# ==============================================================================
# 服务网络与端口配置
# ==============================================================================
HOST_PORT=8095
PORT=8095

# ==============================================================================
# 认证模式配置
# all: 同时启用 OIDC 单点登录与 Mock 快速模拟（推荐开发测试）
# oidc: 仅启用企业 OIDC 单点登录（生产推荐，未登录自动 302 跳转）
# mock: 仅启用演示模拟登录（无外部单点登录依赖）
# ==============================================================================
AUTH_MODE=all

# ==============================================================================
# OIDC / OAuth2 认证单点登录配置 (例如 Authelia / Keycloak / Casdoor / Okta)
# ==============================================================================
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=walk-rally
OIDC_CLIENT_SECRET=your_client_secret_here
OIDC_REDIRECT_URI=https://run.example.com/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email groups
OIDC_USERNAME_CLAIM=preferred_username

# ==============================================================================
# 会话与安全配置
# ==============================================================================
SESSION_SECRET=please-change-to-a-secure-random-secret-key-32-chars!
SESSION_TTL_MS=604800000
SECURE_COOKIES=false

# ==============================================================================
# 系统管理员清单（多个用户名用英文逗号隔开，具备重置战队与导出完整花名册权限）
# ==============================================================================
ADMIN_USERNAMES=admin

# ==============================================================================
# LDAP / Active Directory 企业员工名册同步 (选填，留空则不启用外部目录同步)
# ==============================================================================
LDAP_URI=ldap://127.0.0.1:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your_ldap_password
LDAP_PEOPLE_OU=ou=people
LDAP_GROUPS_OU=ou=groups
