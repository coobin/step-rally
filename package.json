{
  "name": "red-walk-rally",
  "private": true,
  "version": "1.0.0",
  "description": "一步一善·重走经典红色路 组队报名与队长推选系统",
  "type": "module",
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "api:dev": "npm --workspace apps/api run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "build:api": "npm --workspace apps/api run build",
    "start": "npm --workspace apps/api run start"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=20"
  }
}
